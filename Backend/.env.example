# ==============================
# YUGANTRAN 3.0 — Backend .env
# Copy this file to .env and fill in values
# ==============================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/yugantran3?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# Resend Email API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=YUGANTRAN 3.0 <yugantran@geetauniversity.edu.in>

# Google Drive API (for payment receipt uploads)
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Google Sheets (optional - legacy, can remove)
GOOGLE_SHEET_ID=your_sheet_id_here

# App
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
