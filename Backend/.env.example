# ==============================
# YUGANTRAN 3.0 — Backend .env
# Copy this file to .env and fill in values
# ==============================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/yugantran3?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# EMAIL CONFIGURATION (Choose Option A or Option B)
# -------------------------------------------------------------
# OPTION A: Gmail SMTP with App Password (Easiest for testing/production with Gmail)
# Generate a 16-char App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OPTION B: Resend API
# NOTE: Resend requires 'onboarding@resend.dev' for sandbox/testing,
# or a custom domain verified in Resend dashboard (cannot send from @gmail.com).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=YUGANTRAN 3.0 <onboarding@resend.dev>

# -------------------------------------------------------------
# GOOGLE DRIVE API (For payment receipts)
# -------------------------------------------------------------
# NOTE: Google Service Accounts have 0 MB personal quota.
# To upload to Drive, GOOGLE_DRIVE_FOLDER_ID should be a folder inside a
# Google Workspace Shared Drive (Team Drive) where the Service Account has been added as Content Manager.
# If Drive upload fails, receipts are automatically stored locally in Backend/uploads/ as fallback!
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_or_shared_drive_id

# App Settings
PORT=5005
NODE_ENV=development
FRONTEND_URL=http://localhost:5173