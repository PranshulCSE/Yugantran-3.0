# ==============================
# YUGANTRAN 3.0 — Backend .env
# Copy this file to .env and fill in values
# ==============================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/yugantran3?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# EMAIL CONFIGURATION (Choose Option A or Option B)
# -------------------------------------------------------------
# OPTION A: Gmail SMTP with App Password (Easiest for testing/production with Gmail)
# Generate a 16-char App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OPTION B: Resend API
# NOTE: Resend requires 'onboarding@resend.dev' for sandbox/testing,
# or a custom domain verified in Resend dashboard (cannot send from @gmail.com).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=YUGANTRAN 3.0 <onboarding@resend.dev>

# -------------------------------------------------------------
# GOOGLE SHEETS & DRIVE
# -------------------------------------------------------------
# Google Sheet ID (from the spreadsheet URL: /d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# METHOD 1 (Recommended): Google Apps Script Webhook for Drive uploads (Uses personal 15GB Gmail storage)
GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# METHOD 2: Google Service Account (Used for Google Sheets sync & Workspace Shared Drives)
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# App Settings
PORT=5005
NODE_ENV=development
FRONTEND_URL=http://localhost:5173